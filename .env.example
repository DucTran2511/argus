# ============================================
# Local Development Environment Variables
# ============================================
# Copy this file to .env and update with your values
# WARNING: Never commit .env to git!

# ============================================
# Database Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=argus_user
POSTGRES_PASSWORD=argus_local_pass

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=1

# ============================================
# Blockchain Configuration
# ============================================
# Get your Alchemy API key from: https://dashboard.alchemy.com/
# For local dev, you can use the demo key or get a free one
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/demo-key

# Network settings (ethereum, polygon, base, etc.)
BLOCKCHAIN_CHAIN=ethereum
BLOCKCHAIN_NETWORK=mainnet
BLOCKCHAIN_TIMEOUT=30
BLOCKCHAIN_RETRY=3

# ============================================
# AI Configuration (Optional for local dev)
# ============================================
OPENAI_API_KEY=

# ============================================
# Telegram Bot (Optional for local dev)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false

# ============================================
# Server Configuration
# ============================================
SERVER_PORT=8080

# ============================================
# Job Scheduler
# ============================================
BLOCK_MONITOR_INTERVAL=12
